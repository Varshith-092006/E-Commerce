# ==============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Copy this file to .env.production on your secure production deployment host.
# NEVER commit .env.production to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Environment
# ------------------------------------------------------------------------------
NODE_ENV=production

# ------------------------------------------------------------------------------
# Internal Service Security
# ------------------------------------------------------------------------------
# Service mesh trust token. Required in production.
# Generate with: openssl rand -hex 32
INTERNAL_GATEWAY_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS

# ------------------------------------------------------------------------------
# JWT / Authentication
# ------------------------------------------------------------------------------
# HMAC-SHA256 signing secret for user access tokens. Required in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET_MIN_32_CHARS

# ------------------------------------------------------------------------------
# Gateway
# ------------------------------------------------------------------------------
GATEWAY_PORT=4000
PORT=4000

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://your-customer-domain.com,https://your-seller-domain.com,https://your-admin-domain.com
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ------------------------------------------------------------------------------
# PostgreSQL (Isolated Databases per service)
# ------------------------------------------------------------------------------
IDENTITY_DATABASE_URL=postgresql://user:password@host:5432/identity_db?sslmode=require
CATALOG_DATABASE_URL=postgresql://user:password@host:5432/catalog_db?sslmode=require
PAYMENT_DATABASE_URL=postgresql://user:password@host:5432/payment_db?sslmode=require
FULFILLMENT_DATABASE_URL=postgresql://user:password@host:5432/fulfillment_db?sslmode=require
NOTIFICATION_DATABASE_URL=postgresql://user:password@host:5432/notification_db?sslmode=require
ORDER_DATABASE_URL=postgresql://user:password@host:5432/order_db?sslmode=require

POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Redis Caching Layer
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_JITTER_PERCENT=10
CACHE_TTL_PRODUCT_SECONDS=300
CACHE_TTL_PRODUCT_LIST_SECONDS=120
CACHE_TTL_CATEGORY_SECONDS=900
CACHE_TTL_SEARCH_SECONDS=60
CACHE_TTL_AUTOCOMPLETE_SECONDS=60
CACHE_TTL_REVIEW_SECONDS=120
CACHE_TTL_ANALYTICS_SECONDS=180
CACHE_TTL_ADMIN_DASHBOARD_SECONDS=60
CACHE_TTL_SHIPMENT_SECONDS=60
CACHE_TTL_TRACKING_SECONDS=30
CACHE_TTL_INVENTORY_DISPLAY_SECONDS=10
CACHE_TTL_USER_PROFILE_SECONDS=300
CACHE_TTL_NOTIFICATION_PREFERENCES_SECONDS=300

# ------------------------------------------------------------------------------
# Kafka (Event Bus)
# ------------------------------------------------------------------------------
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=ecommerce-platform-prod
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
USE_KAFKA=true

# ------------------------------------------------------------------------------
# Downstream Internal Microservices
# ------------------------------------------------------------------------------
IDENTITY_SVC_PORT=4001
IDENTITY_SVC_URL=http://identity-svc:4001

CATALOG_SVC_PORT=4002
CATALOG_SVC_URL=http://catalog-svc:4002

ORDER_SVC_PORT=4003
ORDER_SVC_URL=http://order-svc:4003

PAYMENT_SVC_PORT=4004
PAYMENT_SVC_URL=http://payment-svc:4004

FULFILLMENT_SVC_PORT=4005
FULFILLMENT_SVC_URL=http://fulfillment-svc:4005

NOTIFICATION_SVC_PORT=4006
NOTIFICATION_SVC_URL=http://notification-svc:4006

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_MODE=live

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=no-reply@yourdomain.com
SMTP_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# SMS / Twilio
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER
SMS_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# Logistics / Couriers
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_TIMEOUT_MS=15000

DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com/api

# ------------------------------------------------------------------------------
# Monitoring (Prometheus & Grafana)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# ------------------------------------------------------------------------------
# Workers
# ------------------------------------------------------------------------------
START_KAFKA_CONSUMERS=true
START_OUTBOX_WORKERS=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=10
OUTBOX_LOCK_TIMEOUT_MS=30000
OUTBOX_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# Phase 3: Traffic Management & API Protection
# ------------------------------------------------------------------------------
LOAD_SHEDDING_ENABLED=true
MAX_INFLIGHT_REQUESTS=150
LOAD_SHEDDING_THRESHOLD_PERCENT=80
LOAD_SHEDDING_THRESHOLD_IMPORTANT_PERCENT=95
LOAD_SHEDDING_RETRY_AFTER_SECONDS=5
MAX_URI_LENGTH=2048
REQUEST_SIZE_LIMIT_JSON=1mb
REQUEST_SIZE_LIMIT_URLENCODED=1mb

