datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "./client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  COD_PENDING
  COD_COLLECTED
}

enum PaymentMethodType {
  RAZORPAY
  COD
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  PUBLISHED
  FAILED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED
}

model Payment {
  id                  String            @id @default(uuid()) @db.Uuid
  user_id             String            @db.Uuid
  order_id            String?           @db.Uuid
  payment_method      PaymentMethodType @default(RAZORPAY)
  status              PaymentStatus     @default(INITIATED)
  amount              Decimal           @db.Decimal(12, 2)
  currency            String            @default("INR") @db.VarChar(10)
  razorpay_order_id   String?           @unique @db.VarChar(100)
  razorpay_payment_id String?           @unique @db.VarChar(100)
  razorpay_signature  String?           @db.VarChar(255)
  failure_reason      String?           @db.Text
  metadata            Json?
  created_at          DateTime          @default(now()) @db.Timestamptz
  updated_at          DateTime          @updatedAt @db.Timestamptz

  refunds PaymentRefund[]

  @@index([user_id])
  @@index([order_id])
  @@index([status])
  @@index([razorpay_order_id])
  @@map("payments")
}

model PaymentRefund {
  id                 String       @id @default(uuid()) @db.Uuid
  payment_id         String       @db.Uuid
  order_id           String       @db.Uuid
  amount             Decimal      @db.Decimal(12, 2)
  currency           String       @default("INR") @db.VarChar(10)
  razorpay_refund_id String?      @unique @db.VarChar(100)
  reason             String?      @db.Text
  status             RefundStatus @default(REQUESTED)
  failure_reason     String?      @db.Text
  created_at         DateTime     @default(now()) @db.Timestamptz
  updated_at         DateTime     @updatedAt @db.Timestamptz

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@unique([payment_id, order_id])
  @@index([payment_id])
  @@index([status])
  @@map("payment_refunds")
}

model PaymentOutbox {
  id             String       @id @default(uuid()) @db.Uuid
  event_type     String       @db.VarChar(100)
  aggregate_type String       @default("Payment") @db.VarChar(50)
  aggregate_id   String       @db.Uuid
  payload        Json
  status         OutboxStatus @default(PENDING)
  retry_count    Int          @default(0)
  max_retries    Int          @default(5)
  next_retry_at  DateTime?    @db.Timestamptz
  locked_at      DateTime?    @db.Timestamptz
  locked_by      String?      @db.VarChar(100)
  last_error     String?      @db.Text
  created_at     DateTime     @default(now()) @db.Timestamptz
  processed_at   DateTime?    @db.Timestamptz

  @@index([status, next_retry_at, created_at])
  @@map("payment_outbox")
}

// ─── Kafka Consumer Idempotency ───────────────────────────────────────────────
// Persists processed Kafka event IDs to prevent duplicate processing across
// process/container restarts and concurrent duplicate events.
// The unique constraint on [consumer_group, event_id] is the idempotency key.
model ProcessedEvent {
  id             String   @id @default(uuid()) @db.Uuid
  event_id       String   @db.VarChar(255)
  consumer_group String   @db.VarChar(100)
  event_type     String   @db.VarChar(100)
  processed_at   DateTime @default(now()) @db.Timestamptz

  @@unique([consumer_group, event_id])
  @@index([consumer_group])
  @@map("payment_processed_events")
}
