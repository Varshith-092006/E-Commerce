# ============================================================
# Ecommerce Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ────────────────────────────────────────────────────────────
# Core Environment
# ────────────────────────────────────────────────────────────
NODE_ENV=development   # development | production | test

# ────────────────────────────────────────────────────────────
# Security — REQUIRED in production
# ────────────────────────────────────────────────────────────

# INTERNAL_GATEWAY_SECRET — Service mesh trust token.
# Injected by gateway when proxying internal requests.
# Must be set in ALL microservices AND the gateway.
# REQUIRED in production. Dev fallback is 'ecom_internal_mesh_secret_dev_2026'.
# Generate with: openssl rand -hex 32
INTERNAL_GATEWAY_SECRET=REPLACE_WITH_STRONG_SECRET_32_CHARS_MIN

# JWT_SECRET — HS256 signing key for access tokens.
# REQUIRED in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET_32_CHARS_MIN

# ────────────────────────────────────────────────────────────
# API Gateway / BFF
# ────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ────────────────────────────────────────────────────────────
# Shared Ephemeral State (Redis)
# ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────────────────────
# PostgreSQL — Isolated Database-Per-Service
# ────────────────────────────────────────────────────────────
# Each service must have DATABASE_URL set to its own DB.
# Do NOT point two services at the same database.

IDENTITY_DB_URL=postgresql://postgres:postgrespassword@localhost:5432/identity_db?schema=public
CATALOG_DB_URL=postgresql://postgres:postgrespassword@localhost:5432/catalog_db?schema=public
ORDER_DB_URL=postgresql://postgres:postgrespassword@localhost:5432/order_db?schema=public
PAYMENT_DB_URL=postgresql://postgres:postgrespassword@localhost:5432/payment_db?schema=public
FULFILLMENT_DB_URL=postgresql://postgres:postgrespassword@localhost:5432/fulfillment_db?schema=public
NOTIFICATION_DB_URL=postgresql://postgres:postgrespassword@localhost:5432/notification_db?schema=public

# PostgreSQL credentials (only needed if running postgres outside Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# ────────────────────────────────────────────────────────────
# Service Ports & Target URLs
# ────────────────────────────────────────────────────────────
IDENTITY_SVC_PORT=4001
IDENTITY_SVC_URL=http://localhost:4001

CATALOG_SVC_PORT=4002
CATALOG_SVC_URL=http://localhost:4002

ORDER_SVC_PORT=4003
ORDER_SVC_URL=http://localhost:4003

PAYMENT_SVC_PORT=4004
PAYMENT_SVC_URL=http://localhost:4004

FULFILLMENT_SVC_PORT=4005
FULFILLMENT_SVC_URL=http://localhost:4005

NOTIFICATION_SVC_PORT=4006
NOTIFICATION_SVC_URL=http://localhost:4006

# ────────────────────────────────────────────────────────────
# Frontend Application Ports
# ────────────────────────────────────────────────────────────
CUSTOMER_WEB_PORT=3000
SELLER_WEB_PORT=3001
ADMIN_WEB_PORT=3002

# ────────────────────────────────────────────────────────────
# Event Bus (Kafka)
# ────────────────────────────────────────────────────────────
# IMPORTANT: Use kafka:29092 inside Docker containers.
#            Use localhost:9092 for local development without Docker.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ecommerce-platform
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# For production with TLS/SASL — leave blank for local dev:
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
USE_KAFKA=true

# Worker toggles (set to 'false' to disable in unit test environments)
START_KAFKA_CONSUMERS=true
START_OUTBOX_WORKERS=true

# Kafka Consumer Group IDs
KAFKA_GROUP_FULFILLMENT_ORDER=fulfillment-order-group
KAFKA_GROUP_FULFILLMENT_PAYMENT=fulfillment-payment-group
KAFKA_GROUP_ORDER_SAGA=order-saga-group
KAFKA_GROUP_NOTIFICATION=notification-group
KAFKA_GROUP_PAYMENT_RETURN=payment-return-group

# ────────────────────────────────────────────────────────────
# Email — Notification Service (Nodemailer/SMTP)
# ────────────────────────────────────────────────────────────
# If not set in development → mock mode (no real email sent, logged only).
# REQUIRED in production. Missing credentials in production = startup warning + all emails fail.
#
# For Gmail: use App Password (not your main password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false  (true for port 465)
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
#
# For SendGrid (TLS/587):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ecommerce.local
SMTP_TIMEOUT_MS=10000

# Force mock mode explicitly (bypasses credential check):
# SMTP_MOCK=true

# ────────────────────────────────────────────────────────────
# SMS — Notification Service (Twilio)
# ────────────────────────────────────────────────────────────
# If not set in development → mock mode (no real SMS sent, logged only).
# REQUIRED in production. Missing credentials in production = startup warning + all SMS fail.
#
# Get credentials from: https://console.twilio.com/
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1234567890  (your Twilio number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TIMEOUT_MS=10000

# Force mock mode explicitly:
# SMS_MOCK=true

# ────────────────────────────────────────────────────────────
# Payment Gateway (Razorpay)
# ────────────────────────────────────────────────────────────
# Get credentials from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────────
# Courier Integrations (Fulfillment Service)
# ────────────────────────────────────────────────────────────
# All courier providers fall back to mock mode if credentials not set.
# Mock mode is safe for development and CI.

# Delhivery — API token from https://app.delhivery.com/
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com/api

# Shiprocket — https://apidocs.shiprocket.in/
# Use the email and password from your Shiprocket account.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_TIMEOUT_MS=15000

# BlueDart — contact bluedart.com for API access
BLUEDART_PROFILE_NAME=
BLUEDART_LICENSE_KEY=
BLUEDART_LOGIN_ID=

# Ekart — contact ekartlogistics.com for API access
EKART_API_KEY=
EKART_CLIENT_CODE=

# ────────────────────────────────────────────────────────────
# Monitoring (Prometheus / Grafana)
# ────────────────────────────────────────────────────────────
# Grafana admin password (used in Docker Compose)
GRAFANA_ADMIN_PASSWORD=changeme

# Prometheus is configured via infra/prometheus/prometheus.yml
# Grafana is configured via infra/grafana/provisioning/

# ────────────────────────────────────────────────────────────
# Notification Outbox Worker Tuning
# ────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000   # Interval between outbox poll cycles
OUTBOX_BATCH_SIZE=10           # Max records processed per cycle
