{
  "name": "ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint \"services/*/src/**/*.js\" \"packages/*/src/**/*.js\" --max-warnings=0",
    "lint:fix": "eslint \"services/*/src/**/*.js\" \"packages/*/src/**/*.js\" --fix",
    "format": "prettier --write \"services/*/src/**/*.js\" \"packages/*/src/**/*.js\"",
    "format:check": "prettier --check \"services/*/src/**/*.js\" \"packages/*/src/**/*.js\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=\"tests/unit\" --passWithNoTests",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=\"tests/integration\" --passWithNoTests --runInBand",
    "build:apps": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspaces --if-present",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d",
    "chaos:test": "node scripts/chaos-test.mjs",
    "chaos:suite": "node scripts/chaos-suite.mjs",
    "backup:databases": "node scripts/backup-databases.mjs",
    "verify:backups": "node scripts/verify-backups.mjs",
    "restore:database": "node scripts/restore-database.mjs",
    "recovery:suite": "node scripts/run-phase8-suite.mjs",
    "edge:test": "node scripts/test-edge-security.mjs",
    "dr:verify-backups": "node scripts/dr/verify-backups.mjs",
    "dr:validate-kafka": "node scripts/dr/validate-kafka-recovery.mjs",
    "dr:validate-services": "node scripts/dr/validate-service-recovery.mjs",
    "dr:verify-recovery": "node scripts/dr/verify-recovery.mjs",
    "dr:reconstruct": "node scripts/dr/dr-reconstruction.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  }
}
