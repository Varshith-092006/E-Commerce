{
  "id": null,
  "uid": "3-kafka",
  "title": "3. Kafka Event-Stream",
  "tags": ["ecommerce", "phase5", "kafka"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Consumer Group Lag (Total)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kafka_consumer_lag) by (group, topic) or vector(0)",
          "legendFormat": "{{group}} ({{topic}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Partition Lag Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "kafka_consumer_lag or vector(0)",
          "legendFormat": "{{topic}}[p{{partition}}] - {{group}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Kafka Processed Events Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kafka_events_consumed_total[1m])) by (topic, event_type) or rate(kafka_events_published_total[1m])",
          "legendFormat": "{{topic}} ({{event_type}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Kafka Retries & Outbox Fallbacks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kafka_event_retries_total[1m])) by (topic) or vector(0)",
          "legendFormat": "retries {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Kafka Errors & Dead-Letter Queue (DLQ)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kafka_dlq_messages_total[1m])) by (topic) or vector(0)",
          "legendFormat": "DLQ {{topic}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(kafka_consumer_errors_total[1m])) by (group) or vector(0)",
          "legendFormat": "Errors {{group}}",
          "refId": "B"
        }
      ]
    }
  ]
}
