{
  "id": null,
  "uid": "5-redis",
  "title": "5. Redis Caching & Locks",
  "tags": ["ecommerce", "phase5", "redis"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Connected Redis Clients",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "redis_connected_clients or vector(1)",
          "legendFormat": "Clients {{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Redis Memory Usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1048576 or vector(0)",
          "legendFormat": "Memory Used (MB)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache Hit vs Miss Ratio (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(rate(redis_keyspace_hits_total[1m]) / clamp_min(rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m]), 0.001)) * 100 or vector(100)",
          "legendFormat": "Hit Ratio %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redis Evictions & Expired Keys",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(redis_evicted_keys_total[1m]) or vector(0)",
          "legendFormat": "Evictions/s",
          "refId": "A"
        },
        {
          "expr": "rate(redis_expired_keys_total[1m]) or vector(0)",
          "legendFormat": "Expired/s",
          "refId": "B"
        }
      ]
    }
  ]
}
