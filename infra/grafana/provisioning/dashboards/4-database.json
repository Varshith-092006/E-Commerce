{
  "id": null,
  "uid": "4-database",
  "title": "4. Database & Connection Pools",
  "tags": ["ecommerce", "phase5", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Database Active Connections by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "db_pool_connections_active or vector(0)",
          "legendFormat": "Active {{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Database Idle Connections by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "db_pool_connections_idle or vector(0)",
          "legendFormat": "Idle {{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Database Connection Pool Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(db_pool_connections_active / clamp_min(db_pool_connections_total, 1)) * 100 or vector(0)",
          "legendFormat": "Utilization % {{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Database Total Pool Capacity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "db_pool_connections_total or vector(10)",
          "legendFormat": "Max Pool {{service}}",
          "refId": "A"
        }
      ]
    }
  ]
}
